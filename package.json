{
  "name": "divinity-cures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "dev": "vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "prepare": "effect-tsgo patch --typescript --no-oxlint && panda codegen",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.effect.json --pretty false"
  },
  "dependencies": {
    "@tanstack/react-form": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "effect": "catalog:effect",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:effect",
    "@oxlint/plugins": "catalog:lint",
    "@pandacss/dev": "catalog:panda",
    "@pandacss/eslint-plugin": "catalog:panda",
    "@pandacss/preset-base": "catalog:panda",
    "@pandacss/preset-panda": "catalog:panda",
    "@pandacss/vite": "catalog:panda",
    "@tanstack/router-plugin": "catalog:tanstack",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:build",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  },
  "packageManager": "pnpm@12.15.0"
}
