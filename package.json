{
  "name": "divinity-cures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "vite build && tsc -b",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev": "vite",
    "format": "eslint . --fix",
    "format:check": "eslint . --max-warnings 0",
    "lint": "eslint . --max-warnings 0",
    "prepare": "panda codegen",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tanstack/react-form": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "effect": "catalog:effect",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@eslint/js": "catalog:lint",
    "@pandacss/dev": "catalog:panda",
    "@pandacss/eslint-plugin": "catalog:panda",
    "@pandacss/preset-base": "catalog:panda",
    "@pandacss/preset-panda": "catalog:panda",
    "@pandacss/vite": "catalog:panda",
    "@stylistic/eslint-plugin": "catalog:lint",
    "@tanstack/router-plugin": "catalog:tanstack",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:build",
    "eslint": "catalog:lint",
    "eslint-plugin-react-hooks": "catalog:lint",
    "globals": "catalog:lint",
    "typescript": "catalog:build",
    "typescript-eslint": "catalog:lint",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  }
}
