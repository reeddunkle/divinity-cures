{
  "name": "divinity-cures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "panda codegen && pnpm typecheck && vite build && node build-plugins/prerender.ts",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "dev": "vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "prepare": "effect-tsgo patch --typescript --no-oxlint && panda codegen",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.effect.json --pretty false"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui",
    "@tanstack/react-form": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "effect": "catalog:effect",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:effect",
    "@oxlint/plugins": "catalog:lint",
    "@pandacss/dev": "catalog:panda",
    "@pandacss/eslint-plugin": "catalog:panda",
    "@pandacss/preset-base": "catalog:panda",
    "@pandacss/preset-panda": "catalog:panda",
    "@pandacss/vite": "catalog:panda",
    "@tanstack/router-plugin": "catalog:tanstack",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:build",
    "@vitest/browser-playwright": "catalog:test",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "playwright": "catalog:test",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "vitest-browser-react": "catalog:test"
  },
   "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
