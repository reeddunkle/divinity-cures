{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "vitest": true
  },
  "ignorePatterns": ["dist", "src/routeTree.gen.ts", "styled-system"],
  "jsPlugins": ["@pandacss/eslint-plugin/oxlint"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "overrides": [
    {
      "files": ["src/routes/**/*.ts", "src/routes/**/*.tsx"],
      "rules": {
        "unicorn/filename-case": "off"
      }
    }
  ],
  "plugins": ["eslint", "oxc", "react", "typescript", "unicorn"],
  "rules": {
    "@pandacss/consistent-property-style": [
      "error",
      {
        "style": "longhand"
      }
    ],
    "@pandacss/extraction-diagnostics": "error",
    "@pandacss/file-not-included": "error",
    "@pandacss/no-debug": "error",
    "@pandacss/no-deprecated": "error",
    "@pandacss/no-important": "error",
    "@pandacss/no-invalid-nesting": "error",
    "@pandacss/no-invalid-token-paths": "error",
    "curly": ["error", "all"],
    "eqeqeq": ["error", "always"],
    "no-continue": "error",
    "no-param-reassign": "error",
    "no-shadow": "error",
    "one-var": ["error", "never"],
    "oxc/no-accumulating-spread": "error",
    "react/hooks": "error",
    "react/react-in-jsx-scope": "off",
    "typescript/array-type": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/prefer-as-const": "error",
    "unicorn/filename-case": "error",
    "unicorn/prefer-at": "error"
  }
}
